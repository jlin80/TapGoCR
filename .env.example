# ---------------------------------------------------------------------------
# TapGoCR — variables de entorno
# Copiar a `.env` y completar. Nunca commitear `.env`.
# ---------------------------------------------------------------------------

# Conexión MySQL/MariaDB.
DATABASE_URL="mysql://usuario:contrasena@localhost:3306/tapgocr"

# Secreto de Auth.js. Generar con: npx auth secret  (o `openssl rand -base64 32`)
AUTH_SECRET=""

# URL canónica de la aplicación.
#
# OBLIGATORIA en producción y debe ser https. La aplicación confía en la
# cabecera Host para funcionar detrás del reverse proxy; sin AUTH_URL fija, un
# Host falsificado podría desviar las URLs de autenticación.
AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Dominio público de TapGoCR
#
# El dominio NO está fijado en el código. Toda URL de tag se construye como
#   {NEXT_PUBLIC_TAPGO_PROTOCOL}://{NEXT_PUBLIC_TAPGO_DOMAIN}/t/{code}
# Cambiar estas dos variables es suficiente para migrar a otro dominio.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_TAPGO_DOMAIN="localhost:3000"
NEXT_PUBLIC_TAPGO_PROTOCOL="http"

# Nombre de marca mostrado en la interfaz.
NEXT_PUBLIC_APP_NAME="TapGoCR"

# Mostrar "Powered by TapGoCR" en el pie de la landing pública.
NEXT_PUBLIC_TAPGO_SHOW_BRANDING="true"

# ---------------------------------------------------------------------------
# Contacto comercial mostrado en la página pública.
#
# Los botones aparecen solo si estos valores están definidos: es preferible una
# página sin botón de contacto a una con un número que no existe.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_CONTACT_EMAIL=""

# Formato internacional, solo dígitos. Ejemplo: 50688887777
NEXT_PUBLIC_CONTACT_WHATSAPP=""

# Código de un tag real para el botón "Ver un ejemplo real" de la página
# comercial. Dejalo vacío si no querés exponer una landing de muestra.
NEXT_PUBLIC_DEMO_TAG_CODE=""

# Envíos por hora y por IP en los formularios públicos.
CONTACT_RATE_LIMIT="3"
REGISTRATION_RATE_LIMIT="3"

# Conexiones simultáneas a MySQL/MariaDB. Subilo solo si la base lo permite.
DATABASE_POOL_MAX="5"

# Zona horaria de los cortes diarios de analytics.
TAPGO_TIMEZONE="America/Costa_Rica"

# Sal para el hash de IP en analytics. Debe ser un valor aleatorio y secreto.
# Rotarla invalida la correlación histórica de visitantes (comportamiento deseado).
ANALYTICS_IP_SALT=""

# ---------------------------------------------------------------------------
# Envío de correo del sistema (avisos de vencimiento de dominio)
#
# Se usa SMTP autenticado contra un proveedor real, NO un servidor de correo
# propio: un correo enviado desde la IP de un VPS nuevo cae en spam durante
# meses. Con relay autenticado, la reputación la pone el proveedor.
#
# Sin estas variables la aplicación funciona igual; simplemente no envía avisos
# y lo indica en la consola de Dominios.
#
# Ejemplos de host: smtp.zoho.com · smtp.gmail.com · smtp.resend.com
# El puerto 587 usa STARTTLS; el 465, TLS implícito.
# ---------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# Remitente visible. Debe ser una dirección del dominio autenticado en el
# proveedor, o los correos se marcarán como falsificados.
SMTP_FROM="TapGoCR <no-reply@tapgocr.com>"

# ---------------------------------------------------------------------------
# Correo entrante (info@/support@/sales@tapgocr.com → #solicitudes)
#
# `scripts/check-inbound-email.ts` (npm run email:check) revisa los tres
# buzones por IMAP. Sin estas variables, ese buzón en particular se omite
# (el script sigue con los otros dos y avisa por consola) — igual que el
# resto del proyecto, un correo no configurado nunca rompe nada.
#
# IMAP_HOST es el servidor real de correo del hosting, no necesariamente el
# mismo dominio público del sitio (que puede estar detrás de un proxy como
# Cloudflare, que no deja pasar IMAP/SMTP).
# ---------------------------------------------------------------------------
IMAP_HOST=""
IMAP_PORT="993"
IMAP_INFO_PASSWORD=""
IMAP_SUPPORT_PASSWORD=""
IMAP_SALES_PASSWORD=""

# ---------------------------------------------------------------------------
# Archivos subidos (menú en PDF, imágenes de un enlace)
#
# IMPORTANTE en producción: esta carpeta debe quedar FUERA del árbol del
# proyecto. Cada despliegue reemplaza todo el código con un `rsync --delete`
# desde el paquete que se sube, así que cualquier ruta dentro del repo se
# borraría en el próximo despliegue. Por ejemplo: /srv/tapgocr-uploads
#
# Sin definirla, se usa ./uploads relativo al proyecto — cómodo en desarrollo,
# nunca en producción.
# ---------------------------------------------------------------------------
UPLOADS_DIR=""

# Tamaño máximo por archivo, en megabytes.
UPLOADS_MAX_MB="10"

# ---------------------------------------------------------------------------
# Notificaciones a Discord (servidor privado de administración de TapGoCR)
#
# Cada variable es el webhook de UN canal. Se configuran de a uno: sin la
# variable, ese canal simplemente no recibe nada — la aplicación sigue
# funcionando igual (ver `src/lib/discord/`). Nunca imprimir estos valores en
# logs, respuestas de API, el frontend ni la documentación.
# ---------------------------------------------------------------------------
DISCORD_WEBHOOK_NEW_CLIENTS=""
DISCORD_WEBHOOK_REQUESTS=""
DISCORD_WEBHOOK_TASKS=""
DISCORD_WEBHOOK_SALES=""
DISCORD_WEBHOOK_ACTIVITY=""
DISCORD_WEBHOOK_ALERTS=""
DISCORD_WEBHOOK_ERRORS=""
DISCORD_WEBHOOK_UPTIME=""
DISCORD_WEBHOOK_DEPLOYMENTS=""
DISCORD_WEBHOOK_BUGS=""
DISCORD_WEBHOOK_ADMIN=""
DISCORD_WEBHOOK_SECURITY=""
DISCORD_WEBHOOK_LOGS=""

# ---------------------------------------------------------------------------
# Monitor de uptime (npm run healthcheck)
#
# Corre cada 1-2 minutos desde un temporizador del sistema y avisa a
# DISCORD_WEBHOOK_UPTIME solo cuando cambia el estado del sitio. Guarda el
# último estado conocido en un archivo, fuera del código, para que sobreviva
# a cada despliegue. Sin esta variable usa UPLOADS_DIR, y si tampoco está,
# ./tmp (solo sirve para desarrollo local).
# ---------------------------------------------------------------------------
HEALTHCHECK_STATE_DIR=""
